generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  plan      String   @default("free")
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searches          Search[]
  collections       Collection[]
  savedSearches     SavedSearch[]
}

model Search {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query         String
  searchType    String   @default("auto")
  dateFrom      DateTime?
  dateTo        DateTime?
  resultLimit   Int
  status        String   @default("pending")
  createdAt     DateTime @default(now())

  filters       SearchFilter?
  job           Job?
  results       SearchResult[]
  collections   CollectionItem[]
}

model SearchFilter {
  id                String   @id @default(cuid())
  searchId          String   @unique
  search            Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  includeDomains    String[]
  excludeDomains    String[]
  contentTypes      String[]
  language          String?
  region            String?
  domainLimit       Int      @default(25)
  diversityEnabled  Boolean  @default(true)
}

model Job {
  id              String   @id @default(cuid())
  searchId        String   @unique
  search          Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  status          String   @default("queued")
  requestedCount  Int
  candidateCount  Int      @default(0)
  processedCount  Int      @default(0)
  acceptedCount   Int      @default(0)
  blockedCount    Int      @default(0)
  duplicateCount  Int      @default(0)
  failedCount     Int      @default(0)
  errorMessage    String?
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([status])
  @@index([searchId])
}

model Page {
  id            String   @id @default(cuid())
  url           String   @unique
  canonicalUrl  String?
  domain        String
  title         String?
  description   String?
  publishedAt   DateTime?
  modifiedAt    DateTime?
  dateSource    String?
  dateConfidence String  @default("low")
  contentType   String?
  language      String?
  safetyStatus  String   @default("unknown")
  httpStatus    Int?
  createdAt     DateTime @default(now())

  searchResults SearchResult[]
  collectionItems CollectionItem[]
}

model SearchResult {
  id              String   @id @default(cuid())
  searchId        String
  search          Search   @relation(fields: [searchId], references: [id], onDelete: Cascade)
  pageId          String
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  rank            Int
  relevanceScore  Float?
  freshnessScore  Float?
  qualityScore    Float?
  createdAt       DateTime @default(now())

  @@unique([searchId, pageId])
  @@index([searchId, rank])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  items CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  pageId       String
  page         Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([collectionId, pageId])
}

model SavedSearch {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  query        String
  searchType   String   @default("auto")
  dateFrom     DateTime?
  dateTo       DateTime?
  resultLimit  Int
  filters      Json?
  createdAt    DateTime @default(now())
}
