# ==============================================================================
# WebScope URL Discovery & Scraping Engine Environment Configuration
# ==============================================================================

# Python Scraping Engine Port (Default: 8000)
PYTHON_SCRAPER_PORT=8000

# Next.js Internal Proxy target to Python Engine
PYTHON_SCRAPER_URL=http://127.0.0.1:8000

# MongoDB Atlas Cloud Persistence (Optional, falls back to local JSON cache)
# Format: mongodb+srv://<username>:<password>@cluster0.usvfwut.mongodb.net
MONGODB_URI=

# Optional separate credentials if not using full URI string
MONGODB_USERNAME=
MONGODB_PASSWORD=
